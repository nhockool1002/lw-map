        'sunset'  => ['name' => 'Sunset Orange', 'css' => 'linear-gradient(135deg, #f59e0b 0%, #ea580c 100%)', 'hex' => '#ea580c'],
        'nature'  => ['name' => 'Lush Green', 'css' => 'linear-gradient(135deg, #10b981 0%, #059669 100%)', 'hex' => '#059669'],
        'royal'   => ['name' => 'Royal Purple', 'css' => 'linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%)', 'hex' => '#7c3aed'],
        'rose'    => ['name' => 'Rose Pink', 'css' => 'linear-gradient(135deg, #f43f5e 0%, #e11d48 100%)', 'hex' => '#e11d48'],
        'dark'    => ['name' => 'Midnight', 'css' => 'linear-gradient(135deg, #334155 0%, #0f172a 100%)', 'hex' => '#0f172a'],
        'fire'    => ['name' => 'Fire Red', 'css' => 'linear-gradient(135deg, #ef4444 0%, #b91c1c 100%)', 'hex' => '#b91c1c'],
        'teal'    => ['name' => 'Teal Ocean', 'css' => 'linear-gradient(135deg, #14b8a6 0%, #0f766e 100%)', 'hex' => '#0f766e'],
        'gold'    => ['name' => 'Luxury Gold', 'css' => 'linear-gradient(135deg, #eab308 0%, #a16207 100%)', 'hex' => '#a16207'],
        'indigo'  => ['name' => 'Deep Indigo', 'css' => 'linear-gradient(135deg, #6366f1 0%, #4338ca 100%)', 'hex' => '#4338ca'],
        'cyan'    => ['name' => 'Cyan Sky', 'css' => 'linear-gradient(135deg, #06b6d4 0%, #0891b2 100%)', 'hex' => '#0891b2'],
        'lime'    => ['name' => 'Citrus Lime', 'css' => 'linear-gradient(135deg, #84cc16 0%, #4d7c0f 100%)', 'hex' => '#4d7c0f'],
        'fuchsia' => ['name' => 'Neon Fuchsia', 'css' => 'linear-gradient(135deg, #d946ef 0%, #a21caf 100%)', 'hex' => '#a21caf'],
